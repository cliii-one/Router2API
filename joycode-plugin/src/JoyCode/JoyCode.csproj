<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>JoyCode</RootNamespace>
    <AssemblyName>JoyCode</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <Description>将 JoyCode（京东 AI 编程助手）的多模型账号接入 Router2API，支持 GLM/Kimi/MiniMax/Doubao/Claude 等模型。</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Router.Contracts" Version="2.0.0" />
  </ItemGroup>
</Project>
